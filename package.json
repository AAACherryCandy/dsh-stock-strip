{
  "name": "dsh-stock-strip",
  "version": "0.2.0",
  "description": "A thin always-on quote bar at the bottom of DeepSeek Harness showing watchlist prices and per-position P&L, with configurable fields, an automatic two-row layout and an English/中文 interface.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preview"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "stock",
    "stocks",
    "quotes",
    "ticker",
    "a-share",
    "portfolio",
    "pnl"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAACherryCandy/dsh-stock-strip.git"
  },
  "homepage": "https://github.com/AAACherryCandy/dsh-stock-strip#readme",
  "bugs": {
    "url": "https://github.com/AAACherryCandy/dsh-stock-strip/issues"
  },
  "author": "AAACherryCandy"
}
